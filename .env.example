# ── 答辩预演舱 环境变量模板 ─────────────────────────────
# 复制为 .env 即可。默认 mock 模式无需任何 Key。

# 运行端口（前后端一体时使用）
PORT=8787

# AI 模式：mock | openai
# mock 为确定性离线引擎，评委无需 Key、无需联网即可复现全部流程
AI_MODE=mock

# 仅 AI_MODE=openai 时需要；任何 OpenAI 兼容接口均可
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 单次请求超时（毫秒）
OPENAI_TIMEOUT=45000

# 演示节奏：1 为正常速度，2 为两倍速。也可在页面上切换
DEMO_SPEED=1

# 数据目录（JSON 持久化，零数据库依赖）
DATA_DIR=./apps/server/data
